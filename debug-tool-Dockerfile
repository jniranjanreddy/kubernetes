apiVersion: v1
kind: Namespace
metadata:
  name: debug
---
apiVersion: v1
kind: Pod
metadata:
  name: debug-pod
  namespace: debug
  labels:
    app: debug-pod
spec:
  restartPolicy: Always
  containers:
    - name: debug-pod
      image: debug/debug-pod:v1
      imagePullPolicy: Always
      command: ["sh", "-c", "while true; do sleep 3600; done"]
      stdin: true
      tty: true
      resources:
        requests:
          cpu: "500m"
          memory: 1Gi
        limits:
          cpu: "1"
          memory: 2Gi
      volumeMounts:
        - name: work
          mountPath: /work
  volumes:
    - name: work
      emptyDir: {}
```
```
kubectl apply -f debug-pod.yaml
kubectl cp .\scripts debug/debug-pod:/work
kubectl exec -n debug debug-pod -- sh -c "chmod +x /work/scripts/*.sh; nohup /work/scripts/your-script.sh > /work/script.log 2>&1 &"
kubectl exec -n debug debug-pod -- tail -f /work/script.log

